# soeltan-agent — copy to .env and fill in. NEVER commit .env or any secret.
# HMAC secret comes from the Agent Games dashboard: agent -> Rotate Secret.
# It is shown ONCE — paste the plaintext here, then redeploy/restart.
AGENT_GAMES_HMAC_SECRET=

# Optional: Kurier mainnet API key for submitting proofs to zkVerify.
# If unset, the agent still answers with proof + public_signals and the
# platform re-verifies; proof_tx then echoes the task's proof_tx.
KURIER_API_KEY=
# KURIER_API_URL=https://api.kurier.xyz/api/v1

# Optional overrides (defaults are the registered mainnet values):
# GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# STEAL_VK_HASH=0x6c56509f1c56fd1fd4e9737f906d2220f4b95f1d507f1adf6899085bd74be047
# KURIER_POLL_BUDGET_MS=15000
# TASK_SOFT_DEADLINE_MS=50000
# SEEN_STORE_PATH=
# CIRCUITS_DIR=
# PORT=8787
